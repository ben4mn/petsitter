# --- Database ---
POSTGRES_USER=petsitter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=petsitter
DATABASE_URL=postgres://petsitter:change-me@db:5432/petsitter

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-secret
# Domain the auth cookie is scoped to. In dev leave blank.
COOKIE_DOMAIN=

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Runtime ---
NODE_ENV=production
PORT=3032
PUBLIC_BASE_URL=https://hanna.example.com
